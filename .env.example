# Leave blank for persistent embedded PostgreSQL on your local machine.
# Required on Vercel. Use a pooled Neon PostgreSQL URL.
DATABASE_URL=
# Optional direct connection for migrations.
DATABASE_URL_UNPOOLED=
DEMO_MODE=true
AI_PROVIDER=mock
OCR_PROVIDER=local
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
STORAGE_PROVIDER=database
# Optional private Vercel Blob store token; required for STORAGE_PROVIDER=vercel-blob.
BLOB_READ_WRITE_TOKEN=
# Optional OCR.Space provider; local fallback handles fixture PDFs and PDF text.
OCR_SPACE_API_KEY=
# Set to a production HTTPS origin; defaults to the request origin locally.
APP_URL=http://localhost:3000
